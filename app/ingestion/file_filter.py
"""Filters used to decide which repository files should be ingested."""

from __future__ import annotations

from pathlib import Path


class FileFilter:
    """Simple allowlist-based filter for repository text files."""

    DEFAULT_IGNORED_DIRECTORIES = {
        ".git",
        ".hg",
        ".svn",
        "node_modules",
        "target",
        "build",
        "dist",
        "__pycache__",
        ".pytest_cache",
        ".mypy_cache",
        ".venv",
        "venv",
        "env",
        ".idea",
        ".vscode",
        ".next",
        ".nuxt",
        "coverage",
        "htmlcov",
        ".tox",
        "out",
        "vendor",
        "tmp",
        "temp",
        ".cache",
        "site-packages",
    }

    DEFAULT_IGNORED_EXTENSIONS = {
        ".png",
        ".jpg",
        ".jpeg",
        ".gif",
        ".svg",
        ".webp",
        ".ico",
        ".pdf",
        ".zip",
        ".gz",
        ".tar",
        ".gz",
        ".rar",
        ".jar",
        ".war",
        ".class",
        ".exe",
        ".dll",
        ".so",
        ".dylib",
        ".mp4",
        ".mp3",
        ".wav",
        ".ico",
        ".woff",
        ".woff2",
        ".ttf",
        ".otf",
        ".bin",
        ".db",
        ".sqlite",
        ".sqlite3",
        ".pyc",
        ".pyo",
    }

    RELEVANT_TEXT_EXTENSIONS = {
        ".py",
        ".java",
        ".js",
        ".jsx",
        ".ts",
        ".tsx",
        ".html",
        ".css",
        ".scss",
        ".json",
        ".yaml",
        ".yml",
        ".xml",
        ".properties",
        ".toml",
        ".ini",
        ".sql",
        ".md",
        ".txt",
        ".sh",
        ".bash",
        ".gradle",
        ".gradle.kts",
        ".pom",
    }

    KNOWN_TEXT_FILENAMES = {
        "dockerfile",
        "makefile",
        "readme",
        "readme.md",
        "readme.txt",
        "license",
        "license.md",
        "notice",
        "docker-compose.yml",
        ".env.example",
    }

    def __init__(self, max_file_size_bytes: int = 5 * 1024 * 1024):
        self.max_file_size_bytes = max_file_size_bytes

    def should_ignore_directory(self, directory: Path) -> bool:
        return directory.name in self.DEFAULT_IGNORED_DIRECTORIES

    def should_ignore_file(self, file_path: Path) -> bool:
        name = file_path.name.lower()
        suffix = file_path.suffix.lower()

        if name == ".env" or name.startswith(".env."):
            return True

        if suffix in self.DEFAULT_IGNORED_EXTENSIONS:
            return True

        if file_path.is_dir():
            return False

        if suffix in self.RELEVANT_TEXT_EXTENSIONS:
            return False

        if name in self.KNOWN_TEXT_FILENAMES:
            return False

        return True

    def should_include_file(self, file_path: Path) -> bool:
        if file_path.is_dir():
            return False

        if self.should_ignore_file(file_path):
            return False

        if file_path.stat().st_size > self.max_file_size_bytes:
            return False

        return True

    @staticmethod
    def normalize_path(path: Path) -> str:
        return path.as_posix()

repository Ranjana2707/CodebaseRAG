"""Data models used by the repository ingestion layer."""

from __future__ import annotations

from dataclasses import dataclass, field
from pathlib import Path
from typing import Dict, Optional


@dataclass
class RepositoryDocument:
    """Represents a text file loaded from a local repository."""

    path: str
    absolute_path: str
    extension: str
    file_type: str
    content: str
    size_bytes: int
    metadata: Dict[str, object] = field(default_factory=dict)

    @property
    def name(self) -> str:
        return Path(self.path).name

    @classmethod
    def from_file(cls, path: Path, repo_root: Path, content: str) -> "RepositoryDocument":
        relative_path = path.relative_to(repo_root).as_posix()
        extension = path.suffix.lower()
        file_type = detect_file_type(path.name, extension)

        return cls(
            path=relative_path,
            absolute_path=str(path),
            extension=extension,
            file_type=file_type,
            content=content,
            size_bytes=path.stat().st_size,
            metadata={
                "repository_root": str(repo_root),
                "language": file_type,
                "readable": True,
            },
        )


def detect_file_type(filename: str, extension: str) -> str:
    """Map file extension or name to a simple, human-readable category."""
    name = filename.lower()
    ext = extension.lower()

    mapping = {
        ".py": "python",
        ".java": "java",
        ".js": "javascript",
        ".jsx": "javascript-react",
        ".ts": "typescript",
        ".tsx": "typescript-react",
        ".md": "markdown",
        ".txt": "text",
        ".json": "json",
        ".yaml": "yaml",
        ".yml": "yaml",
        ".xml": "xml",
        ".sql": "sql",
        ".html": "html",
        ".css": "css",
        ".scss": "scss",
        ".toml": "toml",
        ".ini": "ini",
        ".properties": "properties",
        ".sh": "shell",
        ".bash": "shell",
    }

    if filename.lower() == "dockerfile":
        return "dockerfile"
    if filename.lower() == "makefile":
        return "makefile"
    if name in {"readme", "readme.md", "readme.txt"}:
        return "markdown"

    return mapping.get(ext, "text")


@dataclass
class RepositoryLoadSummary:
    """Summary of repository ingestion statistics."""

    repository_path: str
    files_discovered: int = 0
    files_included: int = 0
    files_ignored: int = 0
    files_failed: int = 0
    total_bytes: int = 0

    def to_dict(self) -> dict:
        return {
            "repository_path": self.repository_path,
            "files_discovered": self.files_discovered,
            "files_included": self.files_included,
            "files_ignored": self.files_ignored,
            "files_failed": self.files_failed,
            "total_bytes": self.total_bytes,
        }
