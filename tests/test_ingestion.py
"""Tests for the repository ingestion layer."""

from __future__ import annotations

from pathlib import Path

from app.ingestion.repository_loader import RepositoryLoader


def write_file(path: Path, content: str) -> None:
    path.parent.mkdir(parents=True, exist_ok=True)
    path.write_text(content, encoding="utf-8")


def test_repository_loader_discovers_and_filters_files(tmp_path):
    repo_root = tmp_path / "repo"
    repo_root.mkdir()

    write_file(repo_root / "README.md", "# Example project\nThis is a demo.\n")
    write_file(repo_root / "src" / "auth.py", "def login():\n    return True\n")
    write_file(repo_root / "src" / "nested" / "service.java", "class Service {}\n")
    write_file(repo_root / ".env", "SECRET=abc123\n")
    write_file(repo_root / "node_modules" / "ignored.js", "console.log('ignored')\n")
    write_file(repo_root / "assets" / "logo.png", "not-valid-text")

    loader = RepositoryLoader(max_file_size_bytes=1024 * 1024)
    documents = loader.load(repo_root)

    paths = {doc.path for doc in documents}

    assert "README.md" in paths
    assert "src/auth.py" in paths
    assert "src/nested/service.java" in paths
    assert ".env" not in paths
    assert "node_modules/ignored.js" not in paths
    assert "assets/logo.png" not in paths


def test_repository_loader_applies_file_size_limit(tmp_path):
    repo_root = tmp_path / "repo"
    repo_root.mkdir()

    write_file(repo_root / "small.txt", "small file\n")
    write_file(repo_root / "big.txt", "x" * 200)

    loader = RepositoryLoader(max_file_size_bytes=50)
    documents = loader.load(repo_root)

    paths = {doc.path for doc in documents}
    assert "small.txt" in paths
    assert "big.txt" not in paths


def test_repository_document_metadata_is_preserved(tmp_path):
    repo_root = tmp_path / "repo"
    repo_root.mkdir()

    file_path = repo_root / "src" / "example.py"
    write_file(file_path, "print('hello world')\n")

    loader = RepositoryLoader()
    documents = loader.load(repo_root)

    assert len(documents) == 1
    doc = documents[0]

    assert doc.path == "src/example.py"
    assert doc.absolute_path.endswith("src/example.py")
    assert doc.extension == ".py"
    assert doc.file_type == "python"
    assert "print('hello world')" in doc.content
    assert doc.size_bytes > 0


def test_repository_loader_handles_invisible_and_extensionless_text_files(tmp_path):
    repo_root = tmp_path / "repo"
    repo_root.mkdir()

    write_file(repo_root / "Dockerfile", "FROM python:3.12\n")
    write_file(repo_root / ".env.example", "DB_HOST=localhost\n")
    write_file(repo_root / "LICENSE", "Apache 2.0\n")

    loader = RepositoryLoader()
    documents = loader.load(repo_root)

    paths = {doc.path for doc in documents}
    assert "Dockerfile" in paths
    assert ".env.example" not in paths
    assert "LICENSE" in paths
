"""Repository loader for local repository ingestion."""

from __future__ import annotations

import logging
import os
from pathlib import Path
from typing import List, Tuple

from .file_filter import FileFilter
from .models import RepositoryDocument, RepositoryLoadSummary

logger = logging.getLogger(__name__)


class RepositoryLoader:
    """Loads relevant source and documentation files from a local repository."""

    def __init__(self, max_file_size_bytes: int = 5 * 1024 * 1024):
        self.filter = FileFilter(max_file_size_bytes=max_file_size_bytes)
        self.max_file_size_bytes = max_file_size_bytes

    def load(self, repository_path: str | os.PathLike) -> List[RepositoryDocument]:
        """Load all eligible repository files and return structured documents."""
        repo_root = Path(repository_path).resolve()
        if not repo_root.exists():
            raise FileNotFoundError(f"Repository path does not exist: {repo_root}")
        if not repo_root.is_dir():
            raise NotADirectoryError(f"Repository path is not a directory: {repo_root}")

        documents: List[RepositoryDocument] = []
        summary = RepositoryLoadSummary(repository_path=str(repo_root))

        for root, dirnames, filenames in os.walk(repo_root):
            root_path = Path(root)

            dirnames[:] = [
                item for item in dirnames if not self.filter.should_ignore_directory(root_path / item)
            ]

            for filename in filenames:
                file_path = root_path / filename
                summary.files_discovered += 1

                if self.filter.should_ignore_file(file_path):
                    summary.files_ignored += 1
                    continue

                if file_path.stat().st_size > self.max_file_size_bytes:
                    summary.files_ignored += 1
                    logger.debug("Skipped oversized file: %s", file_path)
                    continue

                try:
                    raw_content = file_path.read_bytes()
                    content = raw_content.decode("utf-8", errors="replace")
                except OSError as exc:
                    summary.files_failed += 1
                    logger.warning("Failed to read file: %s | %s", file_path, exc)
                    continue

                try:
                    document = RepositoryDocument.from_file(file_path, repo_root, content)
                    documents.append(document)
                    summary.files_included += 1
                    summary.total_bytes += file_path.stat().st_size
                except Exception as exc:  # pragma: no cover - defensive branch
                    summary.files_failed += 1
                    logger.warning("Failed to create repository document for %s: %s", file_path, exc)
                    continue

        logger.info(
            "Repository ingestion completed for %s: discovered=%d included=%d ignored=%d failed=%d",
            repo_root,
            summary.files_discovered,
            summary.files_included,
            summary.files_ignored,
            summary.files_failed,
        )

        return documents

    def load_with_summary(self, repository_path: str | os.PathLike) -> Tuple[List[RepositoryDocument], RepositoryLoadSummary]:
        """Load repository files and return both documents and summary metadata."""
        repo_root = Path(repository_path).resolve()
        if not repo_root.exists():
            raise FileNotFoundError(f"Repository path does not exist: {repo_root}")
        if not repo_root.is_dir():
            raise NotADirectoryError(f"Repository path is not a directory: {repo_root}")

        documents: List[RepositoryDocument] = []
        summary = RepositoryLoadSummary(repository_path=str(repo_root))

        for root, dirnames, filenames in os.walk(repo_root):
            root_path = Path(root)

            dirnames[:] = [
                item for item in dirnames if not self.filter.should_ignore_directory(root_path / item)
            ]

            for filename in filenames:
                file_path = root_path / filename
                summary.files_discovered += 1

                if self.filter.should_ignore_file(file_path):
                    summary.files_ignored += 1
                    continue

                if file_path.stat().st_size > self.max_file_size_bytes:
                    summary.files_ignored += 1
                    logger.debug("Skipped oversized file: %s", file_path)
                    continue

                try:
                    raw_content = file_path.read_bytes()
                    content = raw_content.decode("utf-8", errors="replace")
                except OSError as exc:
                    summary.files_failed += 1
                    logger.warning("Failed to read file: %s | %s", file_path, exc)
                    continue

                try:
                    document = RepositoryDocument.from_file(file_path, repo_root, content)
                    documents.append(document)
                    summary.files_included += 1
                    summary.total_bytes += file_path.stat().st_size
                except Exception as exc:  # pragma: no cover - defensive branch
                    summary.files_failed += 1
                    logger.warning("Failed to transform file %s into repository document: %s", file_path, exc)
                    continue

        return documents, summary
